# F16s Freight OS — Python parsing engine (implementation_guide.md §4.1)
#
# Builds the EXISTING service in ./python: FastAPI + pdfplumber coordinate extraction
# (extract_awb_new.py, ~9k lines). That is the structured-document path PRD §5.1 says
# to keep — coordinates are the right tool for a fixed AWB layout.
#
# Now also carries PyMuPDF (the text layer for /extract-unstructured, ~10x pdfplumber on
# a one-page invoice) and pydantic (schema validation for the model step). pdfplumber
# stays: extract_awb_new.py uses it to CROP coordinate boxes, a different job.
#
# 🔴 No model runs in this image or beside it. Text and scans are read by Gemma 4 31B through
# OpenRouter (model_extract.py, user decision 2026-09-14): self-hosted gemma3:4b took minutes per
# invoice without a GPU, and a GPU host is too expensive to keep idle. OPENROUTER_API_KEY comes
# from the environment.
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY python/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY python/ .

EXPOSE 8000
CMD ["uvicorn", "ocr_server:app", "--host", "0.0.0.0", "--port", "8000"]
