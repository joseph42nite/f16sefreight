# F16s Freight OS — Python parsing engine (implementation_guide.md §4.1)
#
# Builds the EXISTING service in ./python: FastAPI + pdfplumber coordinate extraction
# (extract_awb_new.py, ~9k lines). That is the structured-document path PRD §5.1 says
# to keep — coordinates are the right tool for a fixed AWB layout.
#
# Now also carries PyMuPDF (the text layer for /extract-unstructured, ~10x pdfplumber on
# a one-page invoice) and pydantic (schema validation for the model step). pdfplumber
# stays: extract_awb_new.py uses it to CROP coordinate boxes, a different job.
#
# ⚠️ Ollama and ChromaDB are NOT in this image, and are not meant to be. In production
# they cohost with it on a dedicated t4g.large over loopback (PRD §9.5); locally the
# container reaches Ollama on the host via host.docker.internal, set in docker-compose.
# Gemma needs ~6 GB resident, which PRD §9.6 says not to run on a laptop.
#
# 🔴 Still missing: google-generativeai. /extract-unstructured answers 501 for a scan
# rather than pretending — a document with no text layer cannot be read at all yet.
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY python/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY python/ .

EXPOSE 8000
CMD ["uvicorn", "ocr_server:app", "--host", "0.0.0.0", "--port", "8000"]
