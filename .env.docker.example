# Container-side environment (implementation_guide.md §0.1).
# Copy to .env ONLY when running under docker compose — the committed .env is
# configured for the host workflow (SQLite + `php artisan serve`) and still works.
#
# Services are addressed BY NAME on f16s-network, never by IP.

APP_ENV=local
APP_DEBUG=true
APP_URL=http://focusair.f16s.local:8080

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=f16s
DB_USERNAME=f16s
DB_PASSWORD=secret

REDIS_HOST=redis
REDIS_PORT=6379

# The queue topology in guide §4.10 assumes Redis. `sync` (the default in the host
# .env) runs jobs inline and defeats the whole point of the seven named queues.
QUEUE_CONNECTION=redis
CACHE_DRIVER=redis
SESSION_DRIVER=redis

BROADCAST_DRIVER=pusher
PUSHER_APP_ID=f16s
PUSHER_APP_KEY=f16s-key
PUSHER_APP_SECRET=f16s-secret
PUSHER_HOST=soketi
PUSHER_PORT=6001
PUSHER_SCHEME=http

# The parsing service runs in the stack as `ai-server` (source: ./python).
# Outside the stack it is http://127.0.0.1:8001 — see the committed .env.
OCR_SERVICE_URL=http://ai-server:8000
AI_SERVER_URL=http://ai-server:8000
