APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_CLIENT=predis   # the phpredis C extension is not installed locally
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6380   # docker-compose publishes redis on 6380, not 6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ── Microsoft Graph (mailbox ingestion, guide §4.2) ─────────────────────────
# Register an app in Entra ID → Certificates & secrets for GRAPH_CLIENT_SECRET.
# GRAPH_TENANT: a tenant GUID for a single-tenant app (no verification needed —
# the client's Global Administrator consents), or "common" for multi-tenant.
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_TENANT=common
GRAPH_REDIRECT_URI=http://accounts.localhost/api/user/mailboxes/callback

# The FastAPI parsing engine. Matches the port docker-compose publishes.
OCR_SERVICE_URL=http://127.0.0.1:8000
# Gemma 4 31B through OpenRouter, for invoices and scans (read by the ai-server container)
OPENROUTER_API_KEY=

# Jev — the decision model that files inbound mail into folders (config/mail_intent.php).
# Same OPENROUTER_API_KEY, but a DIFFERENT endpoint: the Decisions API is not under /api/v1,
# and pointing it there returns 404s that read like the model is missing.
JEV_DECISIONS_BASE=https://openrouter.ai/api/alpha
JEV_MODEL=typesafe/jev-1.13
JEV_TIMEOUT=4
# Off files every unmatched mail as Other for a person to re-file — duller, never broken.
MAIL_INTENT_AI=true
# The rubric asks TWO questions — who wrote, and what they want — and each has its own floor.
# `confidence` is how PEAKED the distribution is, so it scales with the number of options: nine
# senders read lower than seven intents for the same real certainty. Below its floor an answer is
# not acted on, though the other one still can be. MIN_CONFIDENCE is the fallback for a question
# that sets none.
MAIL_INTENT_SENDER_FLOOR=0.38
MAIL_INTENT_INTENT_FLOOR=0.50
MAIL_INTENT_MIN_CONFIDENCE=0.60

# Webhook secrets (values never committed)
GLN_WEBHOOK_TOKEN=

# Exchange rates — CurrencyFreaks (api.currencyfreaks.com). `fx:fetch-rates` stores today's every morning; the free
# plan has no history. Without a key, foreign-currency bills cannot be finalized (GAPS #411).
RATE_TOKEN=
OPENCLAW_HMAC_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
